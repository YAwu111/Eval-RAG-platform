# ---- app ----
APP_ENV=development
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- database ----
DATABASE_URL=postgresql+psycopg://rag_eval:rag_eval_dev@localhost:5433/rag_eval

# ---- uploads ----
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# ---- models / cache ----
# 模型缓存放 D 盘，不占 C 盘
HF_HOME=D:\hf-cache
HF_HUB_CACHE=D:\hf-cache\hub
HF_TOKEN=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=auto
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto

# ---- generation (OpenAI compatible) ----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# ---- judges ----
JUDGE_BACKEND=local
JUDGE_NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
JUDGE_RELEVANCE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
JUDGE_DEVICE=auto

# ---- retrieval ----
RETRIEVAL_K=24
RERANK_TOP_K=6
RRF_K=60
